{"_meta":{"source":"Tanzil.net","url":"https://tanzil.net/download/","edition":"uthmani-pause-sajdah","license":"Copie verbatim autorisée, modification interdite, source à citer.","generated":"2026-09-01","sha256":"7e1cb71e09542e405b87da9721dbaac094f6294d554c880a08a1033451c18d87"},"surah":86,"ayahs":{"1":{"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ"},"2":{"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},"3":{"text":"ٱلنَّجْمُ ٱلثَّاقِبُ"},"4":{"text":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},"5":{"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ"},"6":{"text":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},"7":{"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},"8":{"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},"9":{"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},"10":{"text":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},"11":{"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},"12":{"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},"13":{"text":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},"14":{"text":"وَمَا هُوَ بِٱلْهَزْلِ"},"15":{"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},"16":{"text":"وَأَكِيدُ كَيْدًا"},"17":{"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}}}