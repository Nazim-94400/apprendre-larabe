{"_meta":{"source":"Tanzil.net","url":"https://tanzil.net/download/","edition":"uthmani-pause-sajdah","license":"Copie verbatim autorisée, modification interdite, source à citer.","generated":"2026-09-01","sha256":"ef48fd0b9d31a8cc88008de006ab96bfd14abf0f39bb3fa092f3a8b7ff8ea407"},"surah":89,"ayahs":{"1":{"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ"},"2":{"text":"وَلَيَالٍ عَشْرٍ"},"3":{"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ"},"4":{"text":"وَٱلَّيْلِ إِذَا يَسْرِ"},"5":{"text":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"},"6":{"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},"7":{"text":"إِرَمَ ذَاتِ ٱلْعِمَادِ"},"8":{"text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ"},"9":{"text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"},"10":{"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"},"11":{"text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ"},"12":{"text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"},"13":{"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"},"14":{"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"},"15":{"text":"فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"},"16":{"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ"},"17":{"text":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"},"18":{"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},"19":{"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"},"20":{"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"},"21":{"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"},"22":{"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"},"23":{"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"},"24":{"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},"25":{"text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"},"26":{"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"},"27":{"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"},"28":{"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},"29":{"text":"فَٱدْخُلِى فِى عِبَٰدِى"},"30":{"text":"وَٱدْخُلِى جَنَّتِى"}}}