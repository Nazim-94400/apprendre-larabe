{
  "name": "apprendre-larabe",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "PWA hors ligne : de l'alphabet arabe à la récitation du Coran.",
  "license": "SEE LICENSE IN docs/03-sources-et-licences.md",
  "engines": { "node": ">=20" },
  "scripts": {
    "fetch": "node tools/fetch-sources.mjs",
    "fetch:force": "node tools/fetch-sources.mjs --force",
    "build:quran": "node tools/build-quran.mjs",
    "build:tajweed": "node tools/build-tajweed.mjs",
    "build:segments": "node tools/build-segments.mjs",
    "build:vocab": "node tools/build-vocab.mjs",
    "build:review": "node tools/build-review.mjs",
    "build:letter-audio": "node tools/build-letter-audio.mjs",
    "build:translation": "node tools/build-translation.mjs",
    "extract:vocab-pdf": "node tools/extract-vocab-pdf.mjs",
    "build:data": "npm run fetch && npm run build:quran && npm run build:tajweed && npm run build:segments && npm run build:translation && npm run build:vocab",
    "serve": "powershell -ExecutionPolicy Bypass -File tools/serve.ps1",
    "serve:pages": "powershell -ExecutionPolicy Bypass -File tools/serve.ps1 -Port 8081 -Base apprendre-larabe"
  }
}
